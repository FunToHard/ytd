  <LogonCommand>
    <Command>powershell -ExecutionPolicy Bypass -Command "Set-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\CI\Policy' -Name 'VerifiedAndReputablePolicyState' -Value 0; CiTool.exe -r; Start-Process -FilePath 'C:\Users\WDAGUtilityAccount\Desktop\ytd\scripts\sandbox_launch.cmd'"</Command>
  </LogonCommand>
</Configuration>
