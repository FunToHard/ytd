<Configuration>
  <VGpu>Default</VGpu>
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>F:\DEV\projects\ytd</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\ytd</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
